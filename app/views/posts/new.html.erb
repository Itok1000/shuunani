<main class="relative isolate min-h-screen overflow-hidden bg-[#0a0a0c] text-[#e0e0e0]">
<%= form_with url: posts_path, method: :post, id: "diagnosis-form", class: "mx-auto mt-8 w-full max-w-3xl border border-[#00ff66]/50 bg-[#101014]/90 p-5 shadow-[0_0_30px_rgba(0,255,102,0.12)] sm:mt-12 sm:p-8 [&_.question-step]:border-t [&_.question-step]:border-[#00ff66]/25 [&_.question-step]:pt-6 [&_.question-step_h3]:mb-6 [&_.question-step_h3]:text-lg [&_.question-step_h3]:font-semibold [&_.question-step_h3]:leading-8 [&_.question-step_h3]:text-white [&_.question-step_label]:my-2 [&_.question-step_label]:flex [&_.question-step_label]:cursor-pointer [&_.question-step_label]:items-center [&_.question-step_label]:gap-3 [&_.question-step_label]:border [&_.question-step_label]:border-white/10 [&_.question-step_label]:bg-[#0a0a0c] [&_.question-step_label]:px-4 [&_.question-step_label]:py-3 [&_.question-step_label]:text-sm [&_.question-step_label]:transition [&_.question-step_label:hover]:border-[#00ff66]/70 [&_.question-step_label:hover]:bg-[#00ff66]/5 [&_.answer-option]:accent-[#00ff66] [&_.question-step_button]:mt-4 [&_.question-step_button]:border [&_.question-step_button]:border-[#00ff66]/60 [&_.question-step_button]:bg-[#00ff66]/5 [&_.question-step_button]:px-5 [&_.question-step_button]:py-2.5 [&_.question-step_button]:font-semibold [&_.question-step_button]:text-white [&_.question-step_button]:transition [&_.question-step_button:hover]:bg-[#00ff66]/15 [&_.question-step_button:disabled]:cursor-not-allowed [&_.question-step_button:disabled]:opacity-40 [&_.question-step_.result-btn]:border-[#ff007f] [&_.question-step_.result-btn]:bg-[#ff007f]/10 [&_.question-step_.result-btn:hover]:bg-[#ff007f]/20" do |f| %>
  <div id="progress-indicator" class="mb-4 border-b border-[#00ff66]/30 pb-4 font-mono tracking-widest text-[#00ff66]" style="margin-bottom: 1rem; font-weight: 700;">進捗: 0 / 10</div>

  <!-- 第1問 -->
  <div class="question-step" id="step-1" data-step="1" style="display: block;">
    <h3>Q1. トイレの後や帰宅後、手を洗わないことがよくある</h3>
    <% [["当てはまる", 5], ["どちらかと言えば当てはまる", 4], ["どちらともいえない", 3], ["どちらかといえば当てはまらない", 2], ["当てはまらない", 1]].each do |label, value| %>
      <label>
        <%= f.radio_button "answers[q1]", value, class: "answer-option" %> <%= label %>
      </label>
    <% end %>

    <div style="margin-top: 1rem;">
      <button type="button" class="prev-btn" disabled style="margin-right: 0.5rem;">戻る</button>
      <button type="button" class="next-btn">次へ</button>
    </div>
  </div>

  <div class="question-step" id="step-2" data-step="2" style="display: none;">
    <h3>Q2. お風呂に入ったり、歯を磨いたりするのが面倒で何日もサボることがある</h3>
    <% [["当てはまる", 5], ["どちらかと言えば当てはまる", 4], ["どちらともいえない", 3], ["どちらかといえば当てはまらない", 2], ["当てはまらない", 1]].each do |label, value| %>
      <label>
        <%= f.radio_button "answers[q2]", value, class: "answer-option" %> <%= label %>
      </label>
    <% end %>

    <div style="margin-top: 1rem;">
      <button type="button" class="prev-btn" style="margin-right: 0.5rem;">戻る</button>
      <button type="button" class="next-btn">次へ</button>
    </div>
  </div>

  <div class="question-step" id="step-3" data-step="3" style="display: none;">
    <h3>Q3. トイレを流し忘れたり、お風呂場で用を足した経験がある</h3>
    <% [["当てはまる", 5], ["どちらかと言えば当てはまる", 4], ["どちらともいえない", 3], ["どちらかといえば当てはまらない", 2], ["当てはまらない", 1]].each do |label, value| %>
      <label>
        <%= f.radio_button "answers[q3]", value, class: "answer-option" %> <%= label %>
      </label>
    <% end %>

    <div style="margin-top: 1rem;">
      <button type="button" class="prev-btn" style="margin-right: 0.5rem;">戻る</button>
      <button type="button" class="next-btn">次へ</button>
    </div>
  </div>

  <div class="question-step" id="step-4" data-step="4" style="display: none;">
    <h3>Q4. 自分はプライドが高い方だが、他人からの指摘にすぐキレたり激しく落ち込んだりする</h3>
    <% [["当てはまる", 5], ["どちらかと言えば当てはまる", 4], ["どちらともいえない", 3], ["どちらかといえば当てはまらない", 2], ["当てはまらない", 1]].each do |label, value| %>
      <label>
        <%= f.radio_button "answers[q4]", value, class: "answer-option" %> <%= label %>
      </label>
    <% end %>

    <div style="margin-top: 1rem;">
      <button type="button" class="prev-btn" style="margin-right: 0.5rem;">戻る</button>
      <button type="button" class="next-btn">次へ</button>
    </div>
  </div>

  <div class="question-step" id="step-5" data-step="5" style="display: none;">
    <h3>Q5. 他人と接するのが苦手で、集中力が続かず、言われたことをすぐ忘れてしまう</h3>
    <% [["当てはまる", 5], ["どちらかと言えば当てはまる", 4], ["どちらともいえない", 3], ["どちらかといえば当てはまらない", 2], ["当てはまらない", 1]].each do |label, value| %>
      <label>
        <%= f.radio_button "answers[q5]", value, class: "answer-option" %> <%= label %>
      </label>
    <% end %>

    <div style="margin-top: 1rem;">
      <button type="button" class="prev-btn" style="margin-right: 0.5rem;">戻る</button>
      <button type="button" class="next-btn">次へ</button>
    </div>
  </div>

  <div class="question-step" id="step-6" data-step="6" style="display: none;">
    <h3>Q6. 女性に対して強い執着や苦手意識、あるいはこじれた感情を抱いている</h3>
    <% [["当てはまる", 5], ["どちらかと言えば当てはまる", 4], ["どちらともいえない", 3], ["どちらかといえば当てはまらない", 2], ["当てはまらない", 1]].each do |label, value| %>
      <label>
        <%= f.radio_button "answers[q6]", value, class: "answer-option" %> <%= label %>
      </label>
    <% end %>

    <div style="margin-top: 1rem;">
      <button type="button" class="prev-btn" style="margin-right: 0.5rem;">戻る</button>
      <button type="button" class="next-btn">次へ</button>
    </div>
  </div>
  
  <div class="question-step" id="step-7" data-step="7" style="display: none;">
    <h3>Q7. 休学や休職など、人生の途中で長期の立ち止まりを経験したことがある</h3>
    <% [["当てはまる", 5], ["どちらかと言えば当てはまる", 4], ["どちらともいえない", 3], ["どちらかといえば当てはまらない", 2], ["当てはまらない", 1]].each do |label, value| %>
      <label>
        <%= f.radio_button "answers[q7]", value, class: "answer-option" %> <%= label %>
      </label>
    <% end %>

    <div style="margin-top: 1rem;">
      <button type="button" class="prev-btn" style="margin-right: 0.5rem;">戻る</button>
      <button type="button" class="next-btn">次へ</button>
    </div>
  </div>

  <div class="question-step" id="step-8" data-step="8" style="display: none;">
    <h3>Q8. 家庭環境や過去の生い立ちにおいて、不遇な扱いを受けたトラウマがある</h3>
    <% [["当てはまる", 5], ["どちらかと言えば当てはまる", 4], ["どちらともいえない", 3], ["どちらかといえば当てはまらない", 2], ["当てはまらない", 1]].each do |label, value| %>
      <label>
        <%= f.radio_button "answers[q8]", value, class: "answer-option" %> <%= label %>
      </label>
    <% end %>

    <div style="margin-top: 1rem;">
      <button type="button" class="prev-btn" style="margin-right: 0.5rem;">戻る</button>
      <button type="button" class="next-btn">次へ</button>
    </div>
  </div>

  <div class="question-step" id="step-9" data-step="9" style="display: none;">
    <h3>Q9. 狭い空間（トイレなど）に引きこもると落ち着く感覚がある</h3>
    <% [["当てはまる", 5], ["どちらかと言えば当てはまる", 4], ["どちらともいえない", 3], ["どちらかといえば当てはまらない", 2], ["当てはまらない", 1]].each do |label, value| %>
      <label>
        <%= f.radio_button "answers[q9]", value, class: "answer-option" %> <%= label %>
      </label>
    <% end %>

    <div style="margin-top: 1rem;">
      <button type="button" class="prev-btn" style="margin-right: 0.5rem;">戻る</button>
      <button type="button" class="next-btn">次へ</button>
    </div>
  </div>

  <div class="question-step" id="step-10" data-step="10" style="display: none;">
    <h3>Q10. 働くなら絶対にフルリモート（在宅）以外ありえないと強くこだわっている</h3>
    <% [["当てはまる", 5], ["どちらかと言えば当てはまる", 4], ["どちらともいえない", 3], ["どちらかといえば当てはまらない", 2], ["当てはまらない", 1]].each do |label, value| %>
      <label>
        <%= f.radio_button "answers[q10]", value, class: "answer-option" %> <%= label %>
      </label>
    <% end %>

    <div style="margin-top: 1rem;">
      <button type="button" class="prev-btn" style="margin-right: 0.5rem;">戻る</button>
      <button type="submit" class="result-btn">結果を見る</button>
    </div>
  </div>
<% end %>
</main>