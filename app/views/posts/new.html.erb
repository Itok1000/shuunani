<%= form_with url: posts_path, method: :post, id: "diagnosis-form" do |f| %>
  
  <!-- 第1問 -->
  <div class="question-step" id="step-1">
    <h3>Q1. トイレの後や帰宅後、手を洗わないことがよくある</h3>
    <% [["当てはまる", 5], ["どちらかといえば…", 4], ["普通", 3], ["あまり…", 2], ["全く…", 1]].each do |label, value| %>
      <label>
        <%= f.radio_button "answers[q1]", value, class: "answer-option" %> <%= label %>
      </label>
    <% end %>
  </div>

  <!-- 第2問〜第10問も同様に設置（初期状態は CSS で display: none ） -->

  <button type="button" id="next-btn" style="display:none;">次の質問へ</button>
  <%= f.submit "診断結果を見る", id: "submit-btn", style: "display:none;" %>
<% end %>